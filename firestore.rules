rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function callerRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '');
    }

    function isSuperAdmin() {
      return request.auth != null && callerRole() == 'super_admin';
    }

    function isGeneratorOwner() {
      return request.auth != null && callerRole() == 'generator_owner';
    }

    function isAdminLevel() {
      return isSuperAdmin() || isGeneratorOwner();
    }

    match /users/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && (
        request.auth.uid == uid ||
        isSuperAdmin() ||
        isGeneratorOwner()
      );
      allow delete: if isSuperAdmin();
    }

    match /system/{doc} {
      allow read: if true;
      allow write: if isAdminLevel();
    }

    match /bills/{billId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
    }

    match /consumption/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /alerts/{alertId} {
      allow read, update: if request.auth != null &&
        (resource.data.userId == request.auth.uid || isAdminLevel());
      allow create: if request.auth != null;
      allow delete: if request.auth != null &&
        resource.data.userId == request.auth.uid;
    }

    match /complaints/{id} {
      allow read, create: if request.auth != null;
      allow update: if request.auth != null && isAdminLevel();
    }
  }
}
