rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow unauthenticated read of users by phone for login lookup
    // Only allow reading phone/role fields (not sensitive data)
    match /users/{uid} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.uid == uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Generator status — anyone authenticated can read, only admin can write
    match /system/{doc} {
      allow read: if request.auth != null || true;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Bills — owner or admin can read; owner can create; admin can update status
    match /bills/{billId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
    }

    // Alerts — owner can read/update their own; admin can create
    match /alerts/{alertId} {
      allow read, update: if request.auth != null &&
        (resource.data.userId == request.auth.uid ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
      allow create: if request.auth != null;
    }

    // Complaints — authenticated users can read/create; admin can update
    match /complaints/{id} {
      allow read, create: if request.auth != null;
      allow update: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
  }
}
